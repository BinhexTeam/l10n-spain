<odoo>

    <record id="atc_sii_map" model="aeat.sii.map">
        <field name="name">SII - ATC</field>
    </record>
    <record id="atc_sii_map_line_SFESB" model="aeat.sii.map.lines">
        <field name="code">SFESB</field>
        <field
            name="taxes"
            eval="[(6, 0, [
                ref('l10n_es_igic.account_tax_template_s_igic0'),
                ref('l10n_es_igic.account_tax_template_s_igic3'),
                ref('l10n_es_igic.account_tax_template_s_igic7'),
