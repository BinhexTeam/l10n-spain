                ref('l10n_es_igic.account_tax_template_s_igic135'),
                ref('l10n_es_igic.account_tax_template_s_igic20'),
            ])]"
        />
        <field name="sii_map_id" ref="atc_sii_map" />
        <field name="name">SuministroFactEmitidas Sujetas Bienes</field>
    </record>
    <record id="atc_sii_map_line_SFESISP" model="aeat.sii.map.lines">
